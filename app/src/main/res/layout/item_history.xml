<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Disease Name and Confidence -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/diseaseNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Black Sigatoka"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/confidenceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#4CAF50"
                app:cardElevation="0dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/confidenceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Timestamp -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/timestampText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct 26, 2025 04:15 AM"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="#757575"
            android:layout_marginTop="8dp"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@android:drawable/ic_menu_recent_history"
            app:drawableTint="#757575" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
