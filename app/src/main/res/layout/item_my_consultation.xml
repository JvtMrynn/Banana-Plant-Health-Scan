<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvDiseaseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disease Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/Deep_Natural_Green" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@color/Deep_Natural_Green"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Your Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Message:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/Muted_Gray"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your message to expert"
            android:textSize="13sp"
            android:textColor="@color/Near_Black"
            android:layout_marginBottom="8dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sent 2 hours ago"
            android:textSize="12sp"
            android:textColor="@color/Muted_Gray"
            android:layout_marginBottom="8dp" />

        <!-- Attached Analysis -->
        <TextView
            android:id="@+id/tvAttachedAnalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attached analysis: Black Sigatoka - 92%"
            android:textSize="12sp"
            android:textColor="@color/Muted_Gray"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: Example"
            android:textSize="12sp"
            android:textColor="@color/Muted_Gray"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <com.example.capstoneprojectapp.DetectionImageView
            android:id="@+id/ivAnalysisImage"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/image_svg"
            android:contentDescription="Attached analysis image"
            android:visibility="gone" />

        <!-- Conversation -->
        <LinearLayout
            android:id="@+id/conversationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conversation"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/Near_Black"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvConversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expert: Example reply"
                android:textSize="13sp"
                android:textColor="@color/Near_Black" />
        </LinearLayout>

        <!-- Expert Response Section (visible when responded) -->
        <LinearLayout
            android:id="@+id/responseSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Expert Response"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/Deep_Natural_Green"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvExpertName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By: Expert Name"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@color/Muted_Gray"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvExpertResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expert's response"
                android:textSize="13sp"
                android:textColor="@color/Near_Black" />

            <TextView
                android:id="@+id/tvResponseTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Reviewed 1 hour ago"
                android:textSize="11sp"
                android:textColor="@color/Muted_Gray" />
        </LinearLayout>

        <!-- Farmer Follow-up Section -->
        <LinearLayout
            android:id="@+id/followUpSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your follow-up"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/Near_Black"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvFollowUpMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Follow-up details"
                android:textSize="13sp"
                android:textColor="@color/Near_Black" />

            <TextView
                android:id="@+id/tvFollowUpTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sent 1 hour ago"
                android:textSize="11sp"
                android:textColor="@color/Muted_Gray" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFollowUp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send follow-up"
            android:layout_gravity="end"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <!-- Waiting Message (visible when pending) -->
        <TextView
            android:id="@+id/tvWaitingMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Waiting for expert response..."
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="@color/Muted_Gray"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
