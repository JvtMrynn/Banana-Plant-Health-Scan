<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Soft_Mint_Green"
    android:fitsSystemWindows="true"
    tools:context=".ResultActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/Deep_Natural_Green"
        android:elevation="4dp"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Offline banner (shown when using cached data) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/offlineBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFF3CD"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Offline data: Showing cached disease info"
            android:textColor="#7A5B00"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Result Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBackToDashboard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/offlineBanner">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Severity Indicator Bar -->
                <View
                    android:id="@+id/severityIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="24dp"
                    android:background="@color/Deep_Natural_Green"/>

                <!-- Analyzed Image -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="24dp">

                    <com.example.capstoneprojectapp.DetectionImageView
                        android:id="@+id/analyzedImageView"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Analyzed plant image" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Detected Diseases Summary -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detectionsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detections"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingBottom="8dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detectionsListText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="#424242"
                    android:lineSpacingExtra="2dp"
                    android:paddingBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowAllDetections"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show all"
                    android:visibility="gone"
                    android:layout_gravity="end"
                    android:layout_marginBottom="16dp"/>

                <!-- Disease Name -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/diseaseNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disease Name"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:paddingBottom="8dp"/>

                <!-- Scientific Name -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/scientificNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scientific Name"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="italic"
                    android:textColor="#616161"
                    android:gravity="center"
                    android:paddingBottom="16dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="16dp"
                    android:background="#E0E0E0"/>

                <!-- Treatable Status -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/treatableStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Treatable Status"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="@color/Deep_Natural_Green"
                    android:background="#E8F5E9"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Section: Definition -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 Definition"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingBottom="8dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/definitionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disease definition and description"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="#424242"
                    android:lineSpacingExtra="4dp"
                    android:paddingBottom="20dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E0E0E0"/>

                <!-- Section: Management -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/managementHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Management"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingBottom="6dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/managementText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Management steps"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:background="#E8F5E9"
                    android:padding="16dp"
                    android:textColor="#2E7D32"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Section: Prevention -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/preventionHeaderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prevention"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:paddingBottom="6dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/preventionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prevention tips"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:background="#E8F5E9"
                    android:padding="16dp"
                    android:textColor="#2E7D32"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E0E0E0"/>

                <!-- Confidence Level -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/confidenceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Detection Confidence: High"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="#9E9E9E"
                    android:textStyle="italic"/>

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Back to Dashboard Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToDashboard"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Back to Dashboard"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/Deep_Natural_Green"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
